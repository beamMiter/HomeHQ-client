# --- General ---
.DS_Store
*.log
*.swp

# --- Flutter/Dart ---
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
flutter_export_environment.sh

# --- iOS ---
ios/Flutter/.last_build_id
ios/Flutter/ephemeral/
ios/.symlinks/
ios/Pods/
# ควร track ส่วนที่เหลือของ iOS (Runner, Podfile, xcworkspace, etc.)

# --- Android ---
android/.gradle/
android/local.properties
# ควร track:
#   android/gradlew
#   android/gradlew.bat
#   android/gradle/wrapper/gradle-wrapper.jar
#   android/app/src/** (Java/Kotlin Manifest resources ฯลฯ)

# --- macOS ---
macos/Flutter/ephemeral/
macos/Pods/

# --- Windows/Linux (desktop) ---
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# --- VSCode/IDE ---
.idea/
# .vscode/   # ถ้าไม่อยาก commit ก็ uncomment บรรทัดนี้

# --- App configuration (yours, never committed) ---
# Each machine keeps its own .env.development (see the README). The app lists it
# as an asset, so it must exist locally, and CI creates one. It is packed INTO
# the app: never put a secret in it, anyone can unpack an app.
.env.development
.env.production
.env.staging
.env.*.local

# --- Signing keys and credentials (never committed) ---
# Android upload/release keystore and the file that points at it
key.properties
android/key.properties
*.jks
*.keystore
# Apple signing and push (APNs) keys, certificates, provisioning profiles
*.p8
*.p12
*.cer
*.mobileprovision
*.pem
# Service-account and cloud credentials
service-account*.json
*-credentials.json
credentials.json
client_secret*.json
# Local build output that can hold signed apps
*.ipa
*.aab
*.apk

# --- Local environment and editor state (yours, never committed) ---
# Only .env.development ships with the app. A plain .env or .env.local is
# yours, and so is anything a tool keeps about you.
.env
.env.local
.envrc
# launch.json often carries --dart-define values
.vscode/
*.iml
**/xcuserdata/
*.xcuserstate
pubspec_overrides.yaml
.fvm/
# Leftovers of patching
*.orig
*.rej
*.bak

# --- Generated by flutter pub get ---
.flutter-plugins
.flutter-plugins-dependencies
